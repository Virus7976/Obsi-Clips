{
	"name": "clips",
	"version": "0.9.0",
	"description": "Use your clips: find the right highlight while you write, see how often each one is used, and bring back the ones you forgot.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "node test/build.mjs && node --test test-out/*.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.6",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
		"@eslint/js": "^9.39.5",
		"esbuild": "0.24.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.14.4",
		"typescript": "5.6.3",
		"typescript-eslint": "^8.72.2"
	}
}
